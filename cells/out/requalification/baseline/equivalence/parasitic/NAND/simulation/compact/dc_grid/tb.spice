XR_ex_6 n_ex_4 Y VDD F_RR R=10.7142857143 L=30u W=2.8u A=84p P=65.6u m=1
* Estimated lumped wire C to substrate (node 0); not signoff PEX
Ctfwire0 VDD 0 7.808932e-14
Ctfwire1 n_ex_4 0 2.0966129e-14
Ctfwire2 n_ex_6 0 1.32774498e-14
Ctfwire3 A 0 5.1387184e-15
Ctfwire4 B 0 6.6194884e-15
Ctfwire5 Y 0 9.223443e-15
Ctfwire6 n_ex_18 0 4.4645408e-15
Ctfwire7 VSS 0 5.59871538e-14
.ends NAND

.temp 27
.options rshunt=1e12
VDD VDD 0 5
VMID VMID 0 0
VSS VSS 0 -5
Xdut A B Y VDD VMID VSS NAND
Vin0 A 0 PWL(0 -5)
Vin1 B 0 PWL(0 -5)
Cload0 Y 0 1e-14
.nodeset v(Y)=5
.nodeset v(xdut.n_ex_4)=5
.nodeset v(xdut.n_ex_18)=-5
.nodeset v(xdut.n_ex_6)=-5
.control
set noaskquit
set wr_singlescale
set wr_vecnames
set numdgt=15
dc Vin0 -5 5 0.125 Vin1 -5 5 0.125
wrdata waveform.txt v(A) v(B) v(Y) i(vdd) i(vmid) i(vss)
quit
.endc
.end
