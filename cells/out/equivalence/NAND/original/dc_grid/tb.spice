.temp 27
.options rshunt=1e12
VDD VDD 0 5
VMID VMID 0 0
VSS VSS 0 -5
Xdut A B Y VDD VMID VSS NAND
Vin0 A 0 PWL(0 -5)
Vin1 B 0 PWL(0 -5)
Cload0 Y 0 1e-14
.nodeset v(Y)=5
.nodeset v(xdut.n_ex_3)=5
.nodeset v(xdut.n_ex_16)=-5
.nodeset v(xdut.n_ex_5)=-5
.control
set noaskquit
set wr_singlescale
set wr_vecnames
set numdgt=15
dc Vin0 -5 5 0.125 Vin1 -5 5 0.125
wrdata waveform.txt v(A) v(B) v(Y) i(vdd) i(vmid) i(vss)
quit
.endc
.end
